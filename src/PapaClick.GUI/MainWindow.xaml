<Window x:Class="PapaClick.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PapaClick"
        Width="560" Height="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#FAFAFC">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#F0F0F4" Padding="4,2">
            <MenuItem Header="文件" Padding="8,4">
                <MenuItem Header="设置…" Click="OpenSettings_Click" InputGestureText=""/>
                <Separator/>
                <MenuItem Header="退出" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="帮助" Padding="8,4">
                <MenuItem Header="关于" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="#F0F0F4">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="32,28,32,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="点击间隔（秒）" VerticalAlignment="Center" Margin="0,0,16,14"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="IntervalBox" Text="0.001" Height="32"
                     VerticalContentAlignment="Center" Margin="0,0,0,14" Padding="8,0"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="鼠标按键" VerticalAlignment="Center" Margin="0,0,16,14"/>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ButtonBox" Height="32" Margin="0,0,0,14"
                      SelectedIndex="0" VerticalContentAlignment="Center">
                <ComboBoxItem Content="左键"/>
                <ComboBoxItem Content="右键"/>
            </ComboBox>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="点击方式" VerticalAlignment="Center" Margin="0,0,16,14"/>
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="ModeBox" Height="32" Margin="0,0,0,14"
                      SelectedIndex="0" VerticalContentAlignment="Center">
                <ComboBoxItem Content="单击"/>
                <ComboBoxItem Content="双击"/>
            </ComboBox>

            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="BtnStart" Content="开始（F7）" Width="120" Height="36"
                        Click="BtnStart_Click" Padding="0"/>
                <Button x:Name="BtnStop" Content="停止（F7）" Width="120" Height="36"
                        Margin="14,0,0,0" IsEnabled="False" Click="BtnStop_Click" Padding="0"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
