<Window x:Class="PapaClick.GUI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="440" Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FAFAFC">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,0,16,14">
            <Button Content="导入配置" Width="96" Height="30" Margin="0,0,10,0" IsEnabled="False" ToolTip="阶段 1 实现"/>
            <Button Content="导出配置" Width="96" Height="30" Margin="0,0,10,0" IsEnabled="False" ToolTip="阶段 1 实现"/>
            <Button Content="关闭" Width="72" Height="30" Click="Close_Click"/>
        </StackPanel>

        <StackPanel Margin="28,24,28,12">
            <TextBlock Text="常规" FontSize="14" FontWeight="Medium" Margin="0,0,0,10"/>
            <TextBlock Text="启动热键" Margin="0,0,0,6"/>
            <TextBox Text="F7" IsEnabled="False" Height="30" VerticalContentAlignment="Center"
                     ToolTip="阶段 1 实现：可自定义键位组合"/>
            <TextBlock Text="设置将保存到 %AppData%\PapaClick\settings.json（阶段 1 实现）"
                       FontSize="11" Foreground="#888780" Margin="0,18,0,0" TextWrapping="Wrap"/>

            <TextBlock Text="外观" FontSize="14" FontWeight="Medium" Margin="0,22,0,10"/>
            <RadioButton Content="浅色" GroupName="Theme" Margin="0,0,0,6"/>
            <RadioButton Content="深色" GroupName="Theme" Margin="0,0,0,6"/>
            <RadioButton Content="跟随系统" GroupName="Theme" IsChecked="True" Margin="0,0,0,6"
                         ToolTip="阶段 1 实现"/>
        </StackPanel>
    </DockPanel>
</Window>
