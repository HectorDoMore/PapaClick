<Window x:Class="PapaClick.GUI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="460" Height="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBg}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,0,20,16">
            <Button Content="导入配置" Width="92" Height="30" Margin="0,0,10,0" Click="Import_Click"/>
            <Button Content="导出配置" Width="92" Height="30" Margin="0,0,10,0" Click="Export_Click"/>
            <Button Content="保存" Width="80" Height="30" Margin="0,0,10,0" Click="Save_Click"/>
            <Button Content="关闭" Width="72" Height="30" Click="Close_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,24,30,12">

                <TextBlock Text="外观" FontSize="14" FontWeight="Medium" Margin="0,0,0,10"/>
                <RadioButton x:Name="ThemeLight" Content="浅色" GroupName="Theme" Margin="0,0,0,6"
                             Checked="Theme_Changed"/>
                <RadioButton x:Name="ThemeDark" Content="深色" GroupName="Theme" Margin="0,0,0,6"
                             Checked="Theme_Changed"/>
                <RadioButton x:Name="ThemeSystem" Content="跟随系统" GroupName="Theme" Margin="0,0,0,4"
                             Checked="Theme_Changed"/>
                <TextBlock Text="选择后立即预览，点「保存」生效并持久化"
                           FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,16"/>

                <TextBlock Text="启动热键" FontSize="14" FontWeight="Medium" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox x:Name="ModCtrl" Content="Ctrl" Margin="0,0,14,0" VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="ModAlt" Content="Alt" Margin="0,0,14,0" VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="ModShift" Content="Shift" Margin="0,0,14,0" VerticalContentAlignment="Center"/>
                </StackPanel>
                <TextBox x:Name="HotkeyBox" Height="32" IsReadOnly="True" Cursor="Hand"
                         VerticalContentAlignment="Center" GotFocus="HotkeyBox_GotFocus"
                         LostFocus="HotkeyBox_LostFocus" KeyDown="HotkeyBox_KeyDown"
                         ToolTip="点击此处后按下新热键（可为 F 键、字母、数字等，可配合修饰键）"/>
                <TextBlock Text="提示：点击输入框后直接按键即可捕获；按 Esc 取消并保留原热键"
                           FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,16"/>

                <TextBlock Text="防检测抖动" FontSize="14" FontWeight="Medium" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="位置偏移幅度" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="JitterRangeBox" Width="70" Height="30" VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"/>
                    <TextBlock Text="像素（1 ~ 50）" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
                <TextBlock Text="主窗口的抖动开关只控制开/关；幅度在此统一设置"
                           FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,16"/>

                <TextBlock Text="统计" FontSize="14" FontWeight="Medium" Margin="0,0,0,10"/>
                <TextBlock x:Name="TotalClicksText" Text="历史累计点击：0"
                           Foreground="{DynamicResource TextMuted}"/>
                <TextBlock Text="设置文件：%AppData%\PapaClick\settings.json"
                           FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,10,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
